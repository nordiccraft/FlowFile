<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened Runtime: only allow sending Apple Events (reveal in Finder, open folder in Terminal, mail attachments). -->
    <!-- Do NOT add allow-dyld-environment-variables or disable-library-validation: they would re-enable code injection. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
