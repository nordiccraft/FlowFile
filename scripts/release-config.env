# ==============================================================================
# FlowFile – Innstillinger for Deling og Automatiske Oppdateringer
# ==============================================================================

# 1. GitHub-repo der du legger ut nye versjoner (Releases) til venner og kollegaer:
FLOWFILE_REPO="${FLOWFILE_REPO:-nordiccraft/FlowFile}"

# 2. Valgfritt (kun hvis du senere kjøper Apple Developer Program til $99/år):
#    Sett navnet på sertifikatet ditt her, så signeres og notariseres alt automatisk!
SIGN_IDENTITY="${SIGN_IDENTITY:--}"
NOTARY_PROFILE="${NOTARY_PROFILE:-}"
